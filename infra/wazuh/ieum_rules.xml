<!-- Read-only audit input. No active response. Alerts are evidence of observations,
     not proof of successful exfiltration or successful API blocking. -->
<group name="privacygate,ieum,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="service" type="pcre2">^(internal-api|transfer-api|external-api)$</field>
    <description>IEUM application audit</description>
  </rule>
  <rule id="100101" level="3">
    <if_sid>100100</if_sid>
    <field name="result">^deny$</field>
    <description>IEUM denied request: $(service) $(action) ($(reason))</description>
    <group>ieum_audit,</group>
  </rule>
  <rule id="100102" level="3">
    <if_sid>100100</if_sid>
    <field name="result">^allow$</field>
    <description>IEUM allowed operation: $(service) $(action)</description>
    <group>ieum_normal,</group>
  </rule>
  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="result">^error$</field>
    <description>IEUM service error: $(service) $(action) ($(reason))</description>
    <group>ieum_operations,</group>
  </rule>
  <rule id="100110" level="7">
    <if_sid>100101</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^POST /api/admin/member-exports$</action>
    <field name="actor" type="pcre2">^(?!null$).+</field>
    <description>IEUM unauthorized administrator export attempt: $(actor)</description>
    <group>ieum_attack1,</group>
  </rule>
  <rule id="100112" level="10" frequency="3" timeframe="60">
    <if_sid>100110</if_sid>
    <if_matched_sid>100110</if_matched_sid>
    <same_field>actor</same_field>
    <different_field>trace_id</different_field>
    <description>IEUM repeated administrator export denial: same actor, 3 distinct requests in 60s</description>
    <group>ieum_attack1,ieum_repeated,</group>
  </rule>
  <rule id="100111" level="10">
    <if_sid>100101</if_sid>
    <field name="service">^transfer-api$</field>
    <field name="reason" type="pcre2">^(requested_file_not_approved|recipient_mismatch)$</field>
    <description>IEUM requested file or recipient does not match approval: $(actor)</description>
    <group>ieum_attack2,</group>
  </rule>
  <rule id="100120" level="12">
    <if_sid>100101</if_sid>
    <field name="service">^transfer-api$</field>
    <field name="reason" type="pcre2">^(actual_file_hash_mismatch|file_hash_mismatch|file_version_mismatch)$</field>
    <description>IEUM export file integrity mismatch: $(reason)</description>
    <group>ieum_integrity,</group>
  </rule>
  <rule id="100130" level="7">
    <if_sid>100101</if_sid>
    <field name="service">^transfer-api$</field>
    <field name="reason" type="pcre2">^(recipient_only|sender_only)$</field>
    <description>IEUM matching decision ownership violation: $(actor)</description>
    <group>ieum_matching,</group>
  </rule>
  <rule id="100131" level="8">
    <if_sid>100102</if_sid>
    <field name="service">^transfer-api$</field>
    <action type="pcre2">^delivery\.download$</action>
    <field name="reason">^baseline_file_binding_omitted$</field>
    <description>IEUM lab baseline: file binding check omitted; inspect actual response separately</description>
    <group>ieum_baseline,</group>
  </rule>
  <rule id="100132" level="8">
    <if_sid>100102</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^POST /api/admin/member-exports$</action>
    <field name="reason">^baseline_role_check_off$</field>
    <description>IEUM lab baseline: administrator export allowed without role check: $(actor)</description>
    <group>ieum_baseline,ieum_attack1,</group>
  </rule>
  <rule id="100140" level="12">
    <if_sid>100103</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^member_purge$</action>
    <description>IEUM member data deletion failed; inspect retention task</description>
    <group>ieum_lifecycle,</group>
  </rule>
  <rule id="100141" level="10">
    <if_sid>100103</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^evidence_delete$</action>
    <description>IEUM original evidence deletion failed</description>
    <group>ieum_lifecycle,</group>
  </rule>
  <rule id="100142" level="12">
    <if_sid>100103</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^member_account_delete$</action>
    <field name="reason">^not_member_account$</field>
    <description>IEUM account cleanup refused a non-member account target</description>
    <group>ieum_lifecycle,</group>
  </rule>
  <!-- 사후 대응 (자동 임시 잠금·총관리자 조치) -->
  <rule id="100150" level="12">
    <if_sid>100102</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^security\.auto_lock$</action>
    <description>IEUM account automatically locked after repeated denials: $(target_id) ($(reason))</description>
    <group>ieum_response,</group>
  </rule>
  <rule id="100151" level="8">
    <if_sid>100101</if_sid>
    <field name="reason">^account_temporarily_locked$</field>
    <description>IEUM request from temporarily locked account blocked: $(actor) $(action)</description>
    <group>ieum_response,</group>
  </rule>
  <rule id="100152" level="10">
    <if_sid>100102</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^security\.(suspend_account|restore_account|unlock|revoke_deliveries)$</action>
    <description>IEUM security response action by $(actor): $(action) on $(target_id)</description>
    <group>ieum_response,</group>
  </rule>
  <rule id="100153" level="10">
    <if_sid>100103</if_sid>
    <field name="service">^transfer-api$</field>
    <action type="pcre2">^security\.report$</action>
    <description>IEUM transfer could not report an attack-2 incident to internal; review transfer audit</description>
    <group>ieum_response,ieum_operations,</group>
  </rule>
  <!-- 감사 로그 위변조·수집 상태 (privacygate/infra/scripts/audit-verify.sh 결과) -->
  <rule id="100159" level="0">
    <decoded_as>json</decoded_as>
    <field name="service">^audit-verifier$</field>
    <description>IEUM audit chain verifier</description>
  </rule>
  <rule id="100160" level="13">
    <if_sid>100159</if_sid>
    <field name="reason">^audit_chain_broken$</field>
    <description>IEUM audit log tampering detected (hash chain broken): $(target_id)</description>
    <group>ieum_integrity,ieum_audit_tamper,</group>
  </rule>
  <rule id="100161" level="10">
    <if_sid>100159</if_sid>
    <field name="reason" type="pcre2">^(audit_file_missing|audit_collection_stale)$</field>
    <description>IEUM audit log missing or collection stopped: $(target_id) ($(reason))</description>
    <group>ieum_integrity,ieum_operations,</group>
  </rule>
  <!-- 자료 제공 정책 위반 시도 -->
  <rule id="100170" level="8">
    <if_sid>100101</if_sid>
    <field name="service">^transfer-api$</field>
    <field name="reason" type="pcre2">^(consent_invalid|consent_expired|consent_ends_before_delivery|consent_expiry_changed|matching_grant_inactive|matching_grant_missing|approval_revoked)$</field>
    <description>IEUM use of revoked or expired consent/approval: $(actor) ($(reason))</description>
    <group>ieum_consent,</group>
  </rule>
  <rule id="100171" level="10">
    <if_sid>100101</if_sid>
    <field name="reason">^self_approval$</field>
    <description>IEUM requester tried to approve own export request: $(actor)</description>
    <group>ieum_separation_of_duties,</group>
  </rule>
  <rule id="100172" level="8">
    <if_sid>100101</if_sid>
    <field name="reason" type="pcre2">^(scan_pending|scan_blocked|scan_error|file_not_eligible|masked_copy_missing|approved_file_banned)$</field>
    <description>IEUM request for material not reviewed or masked: $(actor) ($(reason))</description>
    <group>ieum_review,</group>
  </rule>
  <rule id="100173" level="9">
    <if_sid>100101</if_sid>
    <field name="service">^transfer-api$</field>
    <field name="reason" type="pcre2">^download_token_(used|invalid|expired|required)$</field>
    <description>IEUM one-time download token misuse: $(actor) ($(reason))</description>
    <group>ieum_download,</group>
  </rule>
  <rule id="100174" level="8">
    <if_sid>100101</if_sid>
    <field name="reason">^download_limit_reached$</field>
    <description>IEUM download limit reached: $(actor) $(target_id)</description>
    <group>ieum_download,</group>
  </rule>
  <rule id="100176" level="3">
    <if_sid>100102</if_sid>
    <field name="service">^transfer-api$</field>
    <action type="pcre2">^delivery\.download$</action>
    <description>IEUM material downloaded: $(actor) $(target_id)</description>
    <group>ieum_download,</group>
  </rule>
  <rule id="100175" level="8" frequency="3" timeframe="300">
    <if_matched_sid>100176</if_matched_sid>
    <same_field>target_id</same_field>
    <different_field>trace_id</different_field>
    <description>IEUM same material downloaded 3 times in 5 minutes: $(actor) $(target_id)</description>
    <group>ieum_download,ieum_repeated,</group>
  </rule>
  <rule id="100177" level="8">
    <if_sid>100101</if_sid>
    <field name="service">^internal-api$</field>
    <field name="reason" type="pcre2">^(member_not_assigned|member_not_in_scope|evidence_not_in_scope|export_not_owned)$</field>
    <description>IEUM staff accessed member outside assignment: $(actor) ($(reason))</description>
    <group>ieum_scope,</group>
  </rule>
  <!-- Keycloak 로그인·관리 이벤트 (internal-api 가 Keycloak 이벤트를 감사 로그로 옮김) -->
  <rule id="100180" level="5">
    <if_sid>100101</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^keycloak\.(login_error|code_to_token_error|refresh_token_error)$</action>
    <description>IEUM Keycloak login failure: $(actor) ($(reason))</description>
    <group>ieum_auth,</group>
  </rule>
  <rule id="100182" level="10">
    <if_sid>100180</if_sid>
    <field name="reason">^user_temporarily_disabled$</field>
    <description>IEUM Keycloak brute-force lockout: $(actor)</description>
    <group>ieum_auth,</group>
  </rule>
  <rule id="100181" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100180</if_matched_sid>
    <same_field>actor</same_field>
    <different_field>trace_id</different_field>
    <description>IEUM repeated Keycloak login failures: same account 5 times in 2 minutes ($(actor))</description>
    <group>ieum_auth,ieum_repeated,</group>
  </rule>
  <rule id="100183" level="10">
    <if_sid>100102</if_sid>
    <field name="service">^internal-api$</field>
    <action type="pcre2">^keycloak\.admin_event$</action>
    <field name="reason" type="pcre2">(realm_role_mapping|client_role_mapping|group_membership|_realm_role$|_client_role$)</field>
    <field name="actor" type="pcre2">^(?!svc:internal-admin$).+</field>
    <description>IEUM Keycloak role or group change by administrator: $(actor) $(reason) $(target_id)</description>
    <group>ieum_auth,ieum_admin_change,</group>
  </rule>
  <!-- nginx 접속 기록 (internal-web·external-web, 쿼리 문자열 없음) -->
  <rule id="100190" level="0">
    <decoded_as>json</decoded_as>
    <field name="log_type">^nginx_access$</field>
    <description>IEUM web access: $(service) $(method) $(uri) $(status)</description>
  </rule>
  <rule id="100194" level="6">
    <if_sid>100190</if_sid>
    <status type="pcre2">^5\d\d$</status>
    <description>IEUM web server error: $(service) $(uri) $(status) (upstream $(upstream_status))</description>
    <group>ieum_web,ieum_operations,</group>
  </rule>
  <rule id="100193" level="3">
    <if_sid>100190</if_sid>
    <status type="pcre2">^4\d\d$</status>
    <description>IEUM web client error: $(service) $(remote_addr) $(method) $(uri) $(status)</description>
    <group>ieum_web,</group>
  </rule>
  <rule id="100192" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100193</if_matched_sid>
    <same_field>remote_addr</same_field>
    <description>IEUM possible web scanning or forced browsing: 10 client errors in 60s from $(remote_addr)</description>
    <group>ieum_web,ieum_repeated,</group>
  </rule>
  <!-- 컨테이너 상태 (docker events) -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="log_type">^docker_event$</field>
    <description>IEUM container event: $(container) $(action)</description>
  </rule>
  <rule id="100203" level="12">
    <if_sid>100200</if_sid>
    <action type="pcre2">^oom$</action>
    <description>IEUM container killed by out-of-memory: $(container)</description>
    <group>ieum_container,ieum_operations,</group>
  </rule>
  <rule id="100202" level="10">
    <if_sid>100200</if_sid>
    <action type="pcre2">^(die|kill|stop)$</action>
    <field name="container" type="pcre2">^matchmaking-(internal-api|transfer-api|external-api|keycloak|business-db|transfer-db|internal-web|external-web|auth-gateway)-\d+$</field>
    <description>IEUM core service container stopped: $(container) $(action) (exit $(exit_code))</description>
    <group>ieum_container,ieum_operations,</group>
  </rule>
  <rule id="100204" level="8">
    <if_sid>100200</if_sid>
    <action type="pcre2">^health_status: unhealthy$</action>
    <description>IEUM container unhealthy: $(container)</description>
    <group>ieum_container,ieum_operations,</group>
  </rule>
  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <action type="pcre2">^(start|restart)$</action>
    <description>IEUM container started: $(container)</description>
    <group>ieum_container,</group>
  </rule>
  <!-- 파일 무결성 검사 (FIM, /monitored = 세 레포 읽기 전용, 비밀값 폴더 제외) -->
  <rule id="100212" level="13">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/monitored/(matchmaking-external/infra/wazuh/|privacygate/infra/db/|privacygate/infra/scripts/audit-verify)</field>
    <description>IEUM detection rule, audit tool or database permission definition changed: $(file)</description>
    <group>ieum_fim,ieum_integrity,</group>
  </rule>
  <rule id="100211" level="12">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/monitored/(privacygate/src/privacygate|matchmaking-external/services/ieum|matchmaking-internal/internal-api/app)/</field>
    <description>IEUM access-control or PrivacyGate policy code changed: $(file)</description>
    <group>ieum_fim,ieum_policy_change,</group>
  </rule>
  <rule id="100210" level="12">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/monitored/[^/]+/(compose[^/]*\.ya?ml|\.env|.*nginx[^/]*\.conf|infra/keycloak/|infra/funnel/)</field>
    <description>IEUM deployment or environment configuration changed (compose/.env/nginx/Keycloak): $(file)</description>
    <group>ieum_fim,ieum_config_change,</group>
  </rule>
</group>
